# ============================================================
# 招聘邮件智能通知系统 —— 环境变量样例
# ============================================================
# 用法：复制本文件为 .env，然后只改这一个文件就够了。
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux / macOS)
#
# 取值优先级：  环境变量（本文件）  >  config/mail.ini  >  代码默认值
#
# 也就是说：config/mail.ini 就是一份通用模板，你不用去动它。
# 想覆盖哪一项，就把下面那一行的注释去掉、填上自己的值。
#
# .env 已被 .gitignore 忽略，永远不会被提交。
# 改完 .env 需要重启进程才生效（环境变量只在进程启动时读一次）。
# ============================================================


# ============================================================
# 1) 收信账号（IMAP）—— 必填
# ============================================================
RECRUIT_IMAP_USER=your_account@qq.com
# QQ / 163 等邮箱这里要填「IMAP 授权码」，不是网页登录密码
RECRUIT_IMAP_PASSWORD=

# ---- 服务商与行为（想覆盖就取消注释）----
# 常用写法：imap.qq.com / imap.163.com / imap.gmail.com
#RECRUIT_IMAP_HOST=imap.qq.com
#RECRUIT_IMAP_PORT=993
#RECRUIT_IMAP_SSL=true
#RECRUIT_IMAP_ENABLED=true
#RECRUIT_IMAP_MAILBOX=INBOX
# 只读模式：不标已读、不删除、不移动
#RECRUIT_IMAP_READONLY=true
# 首次运行（还没有游标）时回看最近多少天
#RECRUIT_IMAP_LOOKBACK_DAYS=30
# 增量拉取方式：uid（推荐，精确）/ since（按时间重捞）
#RECRUIT_IMAP_FETCH_MODE=uid
# 归档文件夹：把识别出的通知复制一份到这里，方便集中查看。
# 例：RECRUIT_IMAP_ARCHIVE_FOLDER=招聘通知
# 留空 = 不归档（程序对邮箱严格只读）
#RECRUIT_IMAP_ARCHIVE_FOLDER=
# 「点开原邮件」的链接模板，可用占位符：
#   {account} {mailbox} {uid} {message_id} {subject} {from_addr} {date}
# Gmail 示例：
#RECRUIT_IMAP_WEBMAIL_URL_TEMPLATE=https://mail.google.com/mail/u/0/#search/rfc822msgid:{message_id}
# 只处理收件人是这些地址的邮件（逗号分隔），留空 = 不限制
#RECRUIT_IMAP_RECIPIENT_ALIASES=


# ============================================================
# 2) 发信账号（SMTP）—— 必填
# ============================================================
RECRUIT_SMTP_USER=your_account@qq.com
RECRUIT_SMTP_PASSWORD=

#RECRUIT_SMTP_HOST=smtp.qq.com
#RECRUIT_SMTP_PORT=465
#RECRUIT_SMTP_SSL=true
#RECRUIT_SMTP_ENABLED=true
# 发件人地址，留空则用 RECRUIT_SMTP_USER
#RECRUIT_SMTP_FROM=
# 发件人在收件人邮箱里显示的名字
#RECRUIT_SMTP_FROM_NAME=招聘邮件助手


# ============================================================
# 3) 汇总推送 —— 至少填收件人
# ============================================================
# 汇总邮件发给谁（多个用英文逗号分隔）—— 通常就是你自己
RECRUIT_NOTIFY_RECIPIENTS=your_account@qq.com

# 时区：决定日期怎么显示、以及 --watch 模式里「每天 10:00」按哪个时区算
RECRUIT_NOTIFY_TIMEZONE=Asia/Shanghai
# 抄送
#RECRUIT_NOTIFY_CC=
# 主题模板，可用占位符 {date} {count}
#RECRUIT_NOTIFY_SUBJECT_TEMPLATE=【招聘汇总】{date} 共 {count} 封待处理
# 哪些类别算「相关邮件」，进汇总
#RECRUIT_NOTIFY_CATEGORIES=interview,written_test
# 一封汇总邮件里最多列多少条
#RECRUIT_NOTIFY_MAX_ITEMS=50
# 当天没有新邮件时也发一封「今日无新通知」
#RECRUIT_NOTIFY_SEND_WHEN_EMPTY=false
# 把「待确认」的低置信度条目附在末尾
#RECRUIT_NOTIFY_INCLUDE_PENDING=true
# 只在有变化时推送（避免一天开几次电脑就收到几封一样的汇总）
#RECRUIT_NOTIFY_PUSH_ONLY_WHEN_CHANGED=true
# 发汇总之前先收一次信（否则拿不到你刚回复的「已完成」）
#RECRUIT_NOTIFY_POLL_BEFORE_SUMMARY=true
# 未完成的每天继续提醒
#RECRUIT_NOTIFY_REMIND_UNFINISHED=true
# 排序：deadline（按截止时间）/ received（按收信时间）
#RECRUIT_NOTIFY_SORT_BY=deadline
# 是否允许「回复汇总邮件」来标记完成
#RECRUIT_NOTIFY_REPLY_ENABLED=true
# 允许发来完成回复的地址（逗号分隔）；留空 = 用 RECRUIT_NOTIFY_RECIPIENTS
#RECRUIT_NOTIFY_REPLY_ALLOWED_SENDERS=
# 以下两项只在 `main.py run --watch` 常驻模式下生效
#RECRUIT_NOTIFY_POLL_MINUTES=10
#RECRUIT_NOTIFY_SUMMARY_TIME=10:00


# ============================================================
# 4) 大模型 —— 不填则分类会降级为「待确认」
# ============================================================
# DeepSeek / OpenAI / 通义 / 本地 vLLM 的 API Key
RECRUIT_LLM_API_KEY=


# ============================================================
# 5) 其它（一般不用动）
# ============================================================
# 备用通知渠道（webhook）的签名密钥
RECRUIT_WEBHOOK_SECRET=
# 旧版时区变量，保留兼容；RECRUIT_NOTIFY_TIMEZONE 优先
#RECRUIT_TZ=Asia/Shanghai
