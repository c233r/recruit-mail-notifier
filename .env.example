# ============================================================
# 招聘邮件通知系统 —— 环境变量样例
# 复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略，不要提交。
# 代码里不会出现任何账号密码，只按 mail.ini / model.ini 里写的变量名来读。
# ============================================================

# ---- IMAP 收信账号 ----
RECRUIT_IMAP_USER=your_account@qq.com
# QQ/163 等邮箱要填「IMAP 授权码」，不是网页登录密码
RECRUIT_IMAP_PASSWORD=

# ---- SMTP 发信账号（可与收信同一个邮箱）----
RECRUIT_SMTP_USER=your_account@qq.com
RECRUIT_SMTP_PASSWORD=

# ---- 大模型（第一版可留空，先把 model.ini 里 enabled 设为 false）----
RECRUIT_LLM_API_KEY=

# ---- 备用通知渠道签名密钥 ----
RECRUIT_WEBHOOK_SECRET=

# ---- 可选：覆盖时区（留空则用 mail.ini 里的 timezone）----
RECRUIT_TZ=Asia/Shanghai
